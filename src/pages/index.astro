---
// src/pages/index.astro
import Layout from "../components/Layout.astro";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const regenerantArticle = `${base}/programs/regenerant-catalunya/article/`;
const regenerantOverview = `${base}/programs/regenerant-catalunya/`;
const actorsHref = `${base}/actors/`;
---

<Layout title="Home" current="home" dataset="Regenerant Catalunya" programView="home">
  <section class="hero">
    <p class="eyebrow">Bioregional Intelligence · Catalunya</p>
    <h1>A living dashboard for the regenerative ecosystem of Catalunya.</h1>
    <p class="lede">
      Cohort showcases, actor networks, and bioregional-health signals — built openly,
      published openly, designed to make the territory legible.
    </p>
  </section>

  <section class="tiles">
    <article class="tile tile-multi">
      <span class="eyebrow">Program</span>
      <h2>Regenerant Catalunya</h2>
      <p>
        11 projects across 2 networks — Miceli Social and La Fundició / Keras Buti — funded through GG24.
        Open the program overview below, or the fullscreen Catalunya Regenerators Map from the Actors tile.
      </p>
      <div class="tile-actions">
        <a class="tile-btn tile-btn-primary" href={regenerantOverview}>↗ Regenerant Catalunya 2025 - overview</a>
      </div>
      <span class="status">Live</span>
    </article>
    <article class="tile tile-multi">
      <span class="eyebrow">Network</span>
      <h2>
        <a class="tile-title-link" href={actorsHref}>Actors</a>
      </h2>
      <p>
        Catalunya&apos;s regenerative ecosystem — territorial, ecosystem, and international actors anchored to comarques.
      </p>
      <div class="tile-actions">
        <a class="tile-btn tile-btn-primary" href={regenerantArticle}>↗ Catalunya Regenerators Map</a>
      </div>
      <span class="status">Coming next</span>
    </article>
    <a class="tile" href={`${base}/indicators/`}>
      <span class="eyebrow">Signals</span>
      <h2>Indicators</h2>
      <p>Bioregional-health signals across Catalunya. In development.</p>
      <span class="status">In development</span>
    </a>
  </section>
</Layout>

<style>
.hero {
  max-width: 60rem;
  margin: 0 auto;
  padding: 4rem 2rem 2rem;
}
.hero h1 {
  margin-top: 0.5rem;
  max-width: 28ch;
}
.hero .lede {
  font-family: var(--serif);
  font-size: 1.1rem;
  color: var(--rule);
  max-width: 50ch;
}
.tiles {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
  gap: 1px;
  background: var(--ink);
  border-top: 1px solid var(--ink);
  border-bottom: 1px solid var(--ink);
}
.tile {
  background: var(--paper);
  padding: 2rem;
  text-decoration: none;
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  transition: background var(--t-fast);
  color: inherit;
}
a.tile:hover {
  background: var(--ivory);
}
.tile-multi {
  gap: 0.65rem;
}
.tile-multi h2 { margin: 0; color: var(--ink); }
.tile-title-link {
  color: inherit;
  text-decoration: none;
}
.tile-title-link:hover {
  text-decoration: underline;
}
.tile-multi p {
  flex: 1;
  color: var(--rule);
  font-family: var(--serif);
  margin: 0;
}
.tile-actions {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  margin-top: 0.25rem;
}
.tile-btn {
  font-family: var(--mono);
  font-size: 0.72rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  text-decoration: none;
  border: 1px solid var(--ink);
  padding: 0.5rem 0.75rem;
  min-height: 44px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  transition: background var(--t-fast), color var(--t-fast), border-color var(--t-fast);
}
.tile-btn-primary {
  background: var(--paper);
  color: var(--ink);
}
.tile-btn-primary:hover {
  background: var(--ink);
  color: var(--paper);
}
.tile-btn-secondary {
  border-color: var(--rule);
  color: var(--rule);
  background: transparent;
}
.tile-btn-secondary:hover {
  border-color: var(--ink);
  background: var(--ivory);
  color: var(--ink);
}
.tile h2 { margin: 0; }
.tile p {
  flex: 1;
  color: var(--rule);
  font-family: var(--serif);
}
.tile .status {
  font-family: var(--mono);
  font-size: 0.7rem;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--ink);
  border-top: 1px dashed var(--rule);
  padding-top: 0.5rem;
  margin-top: 0.35rem;
}
</style>
