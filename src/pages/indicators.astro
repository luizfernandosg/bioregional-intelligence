---
// src/pages/indicators.astro
import Layout from "../components/Layout.astro";
---

<Layout title="Indicators" current="indicators">
  <section class="placeholder">
    <p class="eyebrow">Indicators</p>
    <h1>Bioregional-health signals — in development.</h1>
    <p class="lede">
      We're scoping a set of bioregional-health indicators for Catalunya — what to measure, where the data
      lives, how to surface it without overwhelming the reader. Specific indicators not yet committed.
    </p>
    <p>
      Want to suggest one or contribute? <a href="https://github.com/luizfernandosg/bioregional-intelligence/issues">Open an issue</a>.
    </p>
  </section>
</Layout>

<style>
.placeholder {
  max-width: 38rem;
  margin: 0 auto;
  padding: 6rem 2rem;
  text-align: left;
}
.placeholder .lede {
  font-family: var(--serif);
  font-size: 1.1rem;
  color: var(--rule);
}
</style>
