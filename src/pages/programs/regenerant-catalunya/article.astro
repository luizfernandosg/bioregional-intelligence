---
// src/pages/programs/regenerant-catalunya/article.astro
// Article-companion view of the Regenerant Catalunya program — embedded into / linked from
// the GG24 retrospective article on the RC site. Strips the BIS dashboard chrome (top nav,
// footer) and adds an inline back-link to the dashboard for visitors who arrive directly.
import Layout from "../../../components/Layout.astro";
import NetworkSection from "../../../components/NetworkSection.astro";
import CatalunyaInsetMap from "../../../components/CatalunyaInsetMap.astro";
import { getCollection } from "astro:content";

const entries = await getCollection("cohort");
const doc = entries[0]!.data;
const miceli = doc.projects.filter((p) => p.network === "miceli");
const kerasButi = doc.projects.filter((p) => p.network === "keras-buti");
const fmt = new Intl.NumberFormat("en-US", { style: "currency", currency: "EUR", maximumFractionDigits: 0 });
const totalMatching = doc.networks.miceli.contribution_eur + doc.networks["keras-buti"].contribution_eur;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Layout title="Regenerant Catalunya · Program (article view)" minimal>
  <article class="article-shell">
    <header class="article-hero">
      <p class="eyebrow">Cohort · 2025–2026 · GG24 · Local Funding Program</p>
      <h1>Regenerant Catalunya</h1>
      <p class="lede">
        11 projects · 2 networks · {fmt.format(totalMatching)} matching pool
      </p>
    </header>

    <section class="overview">
      <div class="overview-grid">
        <div class="map-pane">
          <CatalunyaInsetMap projects={doc.projects} />
        </div>
        <div class="summary-pane">
          <article class="net-tile" data-accent="forest">
            <p class="eyebrow">Rural network</p>
            <h2>{doc.networks.miceli.name}</h2>
            <p>{doc.networks.miceli.summary}</p>
            <p class="meta">{fmt.format(doc.networks.miceli.contribution_eur)} · {miceli.length} projects</p>
          </article>
          <article class="net-tile" data-accent="rust">
            <p class="eyebrow">Urban network</p>
            <h2>{doc.networks["keras-buti"].name}</h2>
            <p>{doc.networks["keras-buti"].summary}</p>
            <p class="meta">{fmt.format(doc.networks["keras-buti"].contribution_eur)} · {kerasButi.length} projects</p>
          </article>
        </div>
      </div>
    </section>

    <NetworkSection networkId="miceli" meta={doc.networks.miceli} projects={miceli} />
    <NetworkSection networkId="keras-buti" meta={doc.networks["keras-buti"]} projects={kerasButi} />

    <footer class="article-footer">
      <p class="eyebrow">Funders</p>
      <ul class="funders">
        {doc.funders.map((f) => (
          <li><a href={f.web}>{f.name}</a> · <span>{f.role}</span></li>
        ))}
      </ul>
      <p class="back-link">
        ↗ <a href={`${base}/programs/regenerant-catalunya/`}>Open in the Bioregional Intelligence System dashboard</a>
      </p>
    </footer>
  </article>
</Layout>

<style>
.article-shell {
  max-width: 100%;
  margin: 0;
  padding: 0;
}
.article-hero {
  max-width: 60rem;
  margin: 0 auto;
  padding: 3rem 2rem 2rem;
  text-align: left;
}
.article-hero h1 { margin: 0.25rem 0 0.5rem; }
.article-hero .lede {
  font-family: var(--mono);
  font-size: 0.85rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--rule);
  margin: 0;
}
.overview {
  padding: 2rem;
  background: var(--ivory);
  border-top: 1px solid var(--ink);
  border-bottom: 1px solid var(--ink);
}
.overview-grid {
  display: grid;
  grid-template-columns: 1.1fr 1fr;
  gap: 2rem;
  max-width: 80rem;
  margin: 0 auto;
  align-items: stretch;
}
@media (max-width: 1024px) {
  .overview-grid { grid-template-columns: 1fr; }
}
.summary-pane { display: flex; flex-direction: column; gap: 1rem; }
.net-tile {
  border: 1px solid var(--ink);
  background: var(--paper);
  padding: 1.25rem;
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
}
.net-tile h2 { margin: 0; font-size: 1.3rem; }
.net-tile[data-accent="forest"] h2 { color: var(--forest); }
.net-tile[data-accent="rust"] h2 { color: var(--rust); }
.net-tile p { margin: 0; font-family: var(--serif); }
.net-tile .meta {
  font-family: var(--mono);
  font-size: 0.78rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--rule);
  margin-top: 0.25rem;
}
.article-footer {
  padding: 3rem 2rem;
  max-width: 60rem;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}
.article-footer .funders {
  list-style: none;
  padding: 0;
  margin: 0.25rem 0 1.5rem;
  font-family: var(--serif);
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem 1.5rem;
}
.article-footer .funders li { white-space: nowrap; }
.article-footer .funders a { color: var(--ink); }
.back-link {
  font-family: var(--mono);
  font-size: 0.78rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--rule);
  border-top: 1px dashed var(--rule);
  padding-top: 1rem;
  margin: 1rem 0 0;
}
.back-link a { color: var(--ink); }
</style>
