---
// src/components/Footer.astro
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="row">
    <span class="lockup">Bioregional Intelligence · Catalunya · {year}</span>
    <span class="org">Built by <a href="https://refibcn.cat">ReFi Barcelona</a></span>
  </div>
  <div class="row meta">
    <span>Code · MIT</span>
    <span>Content · CC BY-SA 4.0</span>
    <a href="https://github.com/luizfernandosg/bioregional-intelligence">GitHub</a>
  </div>
</footer>

<style>
.site-footer {
  border-top: 1px solid var(--ink);
  padding: 1.5rem 2rem;
  font-family: var(--mono);
  font-size: 0.75rem;
  color: var(--rule);
  background: var(--paper);
}
.row {
  display: flex;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 0.75rem;
}
.row + .row { margin-top: 0.5rem; opacity: 0.8; }
.lockup { font-family: var(--serif); font-size: 0.85rem; color: var(--ink); }
.org a { color: var(--ink); }
.meta a { color: var(--rule); }
@media (max-width: 640px) {
  .row { flex-direction: column; gap: 0.25rem; }
}
</style>
