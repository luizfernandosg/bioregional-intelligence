---
// src/components/ProjectCard.astro
import type { Project, NetworkMeta } from "../content.config";
import { initialTileDataUrl } from "../lib/initial-tile";

interface Props {
  project: Project;
  networkMeta: NetworkMeta;
}
const { project, networkMeta } = Astro.props;
const image =
  project.image ??
  initialTileDataUrl({
    initial: project.name.charAt(0),
    accent: networkMeta.accent,
  });
const themeLabel = project.theme.replace(/-/g, " ");
---

<article class="card" data-project-id={project.id} data-network={project.network}>
  <a class="card-link" href={project.links.web ?? "#"} target={project.links.web ? "_blank" : undefined} rel={project.links.web ? "noopener noreferrer" : undefined}>
    <div class="image-wrap">
      <img src={image} alt={`${project.name} — ${project.theme}`} loading="lazy" />
      <span class="network-chip" data-accent={networkMeta.accent}>{networkMeta.name.split(" / ")[0]}</span>
    </div>
    <div class="body">
      <h3>{project.name}</h3>
      <p class="locality">{project.locality}</p>
      <p class="summary">{project.summary}</p>
      <div class="meta">
        <span class="theme-tag">{themeLabel}</span>
        {project.links.web && <span class="ext" aria-label="External link">↗</span>}
      </div>
    </div>
  </a>
</article>

<style>
.card {
  border: 1px solid var(--ink);
  background: var(--paper);
  display: flex;
  flex-direction: column;
  transition: transform var(--t-fast), box-shadow var(--t-fast);
}
.card:hover { transform: translateY(-2px); box-shadow: 4px 4px 0 var(--ink); }
.card-link {
  text-decoration: none;
  color: var(--ink);
  display: flex;
  flex-direction: column;
  height: 100%;
}
.image-wrap {
  position: relative;
  aspect-ratio: 16 / 9;
  overflow: hidden;
  background: var(--ivory);
  border-bottom: 1px solid var(--ink);
}
.image-wrap img { width: 100%; height: 100%; object-fit: cover; }
.network-chip {
  position: absolute;
  top: 0.5rem;
  left: 0.5rem;
  padding: 0.2rem 0.5rem;
  font-family: var(--mono);
  font-size: 0.65rem;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  background: var(--paper);
  border: 1px solid var(--ink);
}
.network-chip[data-accent="forest"] { color: var(--forest); }
.network-chip[data-accent="rust"]   { color: var(--rust); }
.body {
  padding: 1rem;
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
  flex: 1;
}
.body h3 {
  font-family: var(--serif);
  font-weight: 500;
  font-size: 1.05rem;
  margin: 0;
}
.locality {
  font-family: var(--mono);
  font-size: 0.7rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--rule);
  margin: 0;
}
.summary {
  font-family: var(--serif);
  font-size: 0.92rem;
  color: var(--ink);
  margin: 0;
  flex: 1;
  line-height: 1.45;
}
.meta {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-top: 0.5rem;
  border-top: 1px dashed var(--rule);
  padding-top: 0.5rem;
}
.theme-tag {
  font-family: var(--mono);
  font-size: 0.7rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--rule);
}
.ext { font-family: var(--mono); color: var(--rule); }
</style>
