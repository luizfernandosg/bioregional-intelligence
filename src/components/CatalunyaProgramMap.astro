---
// src/components/CatalunyaProgramMap.astro
// Article-view interactive program map. Bigger than CatalunyaInsetMap; clicking a
// marker pops up the project's card inside the map host.
import type { Project, NetworkMeta } from "../content.config";
import { initialTileDataUrl } from "../lib/initial-tile";

interface Props {
  projects: Project[];
  networks: Record<"miceli" | "keras-buti", NetworkMeta>;
}
const { projects, networks } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
const geoUrl = `${baseUrl}/geo/catalunya-comarques.geojson`;
const payload = projects.map((p) => ({
  id: p.id,
  lat: p.geo.lat,
  lng: p.geo.lng,
  name: p.name,
  network: p.network,
  locality: p.locality,
}));
const cardImage = (p: Project): string => {
  if (p.image) return `${baseUrl}${p.image}`;
  const meta = networks[p.network];
  return initialTileDataUrl({ initial: p.name.charAt(0), accent: meta.accent });
};
---

<div class="program-map" data-program-map data-geo-url={geoUrl}>
  <svg viewBox="0 0 1400 900" preserveAspectRatio="xMidYMid meet" aria-label="Regenerant Catalunya — interactive program map">
    <g class="comarques"></g>
    <g class="markers"></g>
    <g class="subzoom" transform="translate(1140 720)">
      <rect class="subzoom-frame" x="0" y="0" width="240" height="160"/>
      <text class="subzoom-label" x="8" y="16">L'Hospitalet · Baix Llobregat</text>
      <g class="subzoom-comarques"></g>
      <g class="subzoom-markers"></g>
    </g>
  </svg>

  <p class="map-hint">Click a marker to open the project</p>

  <!-- Pre-rendered popover cards (hidden by default; revealed on marker click). -->
  <div class="popover-stack" aria-live="polite">
    {projects.map((p) => {
      const meta = networks[p.network];
      const themeLabel = p.theme.replace(/-/g, " ");
      return (
        <article class="popover-card" data-popover-id={p.id} data-network={p.network} hidden>
          <button class="popover-close" type="button" aria-label="Close project">×</button>
          <div class="image-wrap">
            <img src={cardImage(p)} alt={`${p.name} — ${p.theme}`} loading="lazy" />
            <span class="network-chip" data-accent={meta.accent}>{meta.name.split(" / ")[0]}</span>
          </div>
          <div class="body">
            <h3>{p.name}</h3>
            <p class="locality">{p.locality}</p>
            <p class="summary">{p.summary}</p>
            <div class="meta">
              <span class="theme-tag">{themeLabel}</span>
              {p.links.web && (
                <a class="ext-link" href={p.links.web} target="_blank" rel="noopener noreferrer">↗ visit</a>
              )}
            </div>
          </div>
        </article>
      );
    })}
  </div>

  <script type="application/json" data-payload set:html={JSON.stringify(payload)}></script>
</div>

<script>
import * as d3 from "d3";
import {
  CATALUNYA_DEFAULT,
  LHOSPITALET_SUBZOOM,
  makeProjection,
  placeMarkers,
} from "../lib/catalunya-projection";

interface Marker {
  id: string;
  lat: number;
  lng: number;
  name: string;
  network: "miceli" | "keras-buti";
  locality: string;
}

const ACCENT_FILL: Record<string, string> = {
  miceli: "#8B5A3C",
  "keras-buti": "#6B4EA3",
};

document.querySelectorAll<HTMLDivElement>("[data-program-map]").forEach(async (host) => {
  const payloadEl = host.querySelector<HTMLScriptElement>('[data-payload]');
  if (!payloadEl) return;
  const markers: Marker[] = JSON.parse(payloadEl.textContent ?? "[]");

  const geoUrl = host.dataset.geoUrl ?? "/geo/catalunya-comarques.geojson";
  const geoResp = await fetch(geoUrl);
  const geo = await geoResp.json();

  const svg = d3.select(host).select("svg");
  const projection = makeProjection(CATALUNYA_DEFAULT);
  const path = d3.geoPath(projection);

  // Main map comarques
  svg.select<SVGGElement>("g.comarques")
    .selectAll("path")
    .data(geo.features)
    .join("path")
    .attr("d", (d) => path(d as any) ?? "")
    .attr("class", "comarca");

  const isLHospitalet = (m: Marker) =>
    m.locality.toLowerCase().includes("l'hospitalet");
  const placedMain = placeMarkers(
    markers.filter((m) => !isLHospitalet(m)),
    projection,
  );
  const lhospitaletMarkers = markers.filter(isLHospitalet);

  // No cluster pseudo-marker on this view — the sub-zoom alone shows the L'H markers.
  // (Avoids confusion: clicking a cluster marker had no clear "which project" mapping.)
  drawMarkers(svg.select<SVGGElement>("g.markers"), placedMain, 10);

  const subProjection = makeProjection(LHOSPITALET_SUBZOOM);
  const subPath = d3.geoPath(subProjection);
  const subFeatures = (geo.features as any[]).filter((f) => {
    const name = (f.properties?.NOMCOMAR || f.properties?.name || "").toLowerCase();
    return name.includes("barcelonès") || name.includes("baix llobregat");
  });
  svg.select<SVGGElement>("g.subzoom-comarques")
    .selectAll("path")
    .data(subFeatures)
    .join("path")
    .attr("d", (d) => subPath(d as any) ?? "")
    .attr("class", "subzoom-comarca");

  const placedSub = placeMarkers(lhospitaletMarkers, subProjection);
  drawMarkers(svg.select<SVGGElement>("g.subzoom-markers"), placedSub, 6);

  function drawMarkers(g: d3.Selection<SVGGElement, unknown, null, undefined>, items: any[], radius: number) {
    g.selectAll("g.marker")
      .data(items, (d: any) => d.id)
      .join((enter) => {
        const node = enter.append("g")
          .attr("class", "marker")
          .attr("data-project-id", (d: any) => d.id)
          .attr("data-network", (d: any) => d.network)
          .attr("transform", (d: any) => `translate(${d.x},${d.y})`)
          .attr("tabindex", 0)
          .attr("role", "button")
          .attr("aria-label", (d: any) => `${d.name} — ${d.locality}`);
        node.append("circle")
          .attr("r", radius)
          .attr("fill", (d: any) => ACCENT_FILL[d.network] ?? "#1d1a16")
          .attr("stroke", "#1d1a16")
          .attr("stroke-width", 2);
        node.append("title").text((d: any) => `${d.name} · ${d.locality}`);
        return node;
      });
  }

  // Popover behavior: click marker → reveal matching popover card; click outside / Esc → close.
  const popovers = host.querySelectorAll<HTMLElement>("[data-popover-id]");
  const allMarkerNodes = svg.selectAll<SVGGElement, unknown>("g.marker");
  const hint = host.querySelector<HTMLElement>(".map-hint");

  const closePopovers = () => {
    popovers.forEach((p) => (p.hidden = true));
    allMarkerNodes.classed("active", false);
    if (hint) hint.style.opacity = "1";
  };

  const openPopover = (id: string) => {
    closePopovers();
    const target = host.querySelector<HTMLElement>(`[data-popover-id="${id}"]`);
    if (!target) return;
    target.hidden = false;
    svg.selectAll<SVGGElement, unknown>(`g.marker[data-project-id="${id}"]`).classed("active", true);
    if (hint) hint.style.opacity = "0";
  };

  allMarkerNodes.each(function (this: SVGGElement) {
    const id = this.getAttribute("data-project-id");
    if (!id) return;
    const sel = d3.select(this);
    sel.on("click", (event) => {
      event.stopPropagation();
      openPopover(id);
    });
    sel.on("keydown", (event: KeyboardEvent) => {
      if (event.key === "Enter" || event.key === " ") {
        event.preventDefault();
        openPopover(id);
      }
    });
  });

  // Close handlers
  popovers.forEach((p) => {
    const closeBtn = p.querySelector<HTMLButtonElement>(".popover-close");
    closeBtn?.addEventListener("click", () => closePopovers());
  });
  host.addEventListener("click", (event) => {
    const target = event.target as HTMLElement;
    if (target.closest("[data-popover-id]") || target.closest("g.marker")) return;
    closePopovers();
  });
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") closePopovers();
  });
});
</script>

<style>
.program-map {
  position: relative;
  width: 100%;
  height: clamp(520px, 78vh, 880px);
  background: var(--ivory);
  border: 1px solid var(--ink);
  overflow: hidden;
}
.program-map svg {
  width: 100%;
  height: 100%;
  display: block;
}

.map-hint {
  position: absolute;
  top: 1rem;
  left: 1rem;
  margin: 0;
  padding: 0.4rem 0.7rem;
  font-family: var(--mono);
  font-size: 0.7rem;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--rule);
  background: var(--paper);
  border: 1px solid var(--rule);
  pointer-events: none;
  transition: opacity var(--t-fast);
}

:global(.program-map .comarca),
:global(.program-map .subzoom-comarca) {
  fill: rgba(0, 0, 0, 0.03);
  stroke: var(--ink);
  stroke-width: 0.5;
  stroke-dasharray: 1 2;
}
:global(.program-map .marker) {
  cursor: pointer;
  transition: transform var(--t-fast);
  transform-box: fill-box;
  transform-origin: center;
}
:global(.program-map .marker:hover circle),
:global(.program-map .marker:focus-visible circle),
:global(.program-map .marker.active circle) {
  stroke-width: 3;
}
:global(.program-map .marker.active circle) {
  filter: drop-shadow(0 0 0 var(--ink));
  r: 14;
}
:global(.program-map .subzoom-frame) {
  fill: var(--paper);
  stroke: var(--ink);
  stroke-width: 1;
}
:global(.program-map .subzoom-label) {
  font-family: var(--mono);
  font-size: 9px;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  fill: var(--rule);
}

.popover-stack {
  position: absolute;
  top: 1.5rem;
  right: 1.5rem;
  width: min(360px, calc(100% - 3rem));
  pointer-events: none;
}
.popover-card {
  pointer-events: auto;
  background: var(--paper);
  border: 1px solid var(--ink);
  box-shadow: 6px 6px 0 var(--ink);
  display: flex;
  flex-direction: column;
  position: relative;
  animation: popover-in 220ms ease;
}
@keyframes popover-in {
  from { opacity: 0; transform: translateY(-4px) scale(0.98); }
  to   { opacity: 1; transform: translateY(0) scale(1); }
}
.popover-card[hidden] { display: none; }

.popover-close {
  position: absolute;
  top: 0.4rem;
  right: 0.4rem;
  width: 1.7rem;
  height: 1.7rem;
  border: 1px solid var(--ink);
  background: var(--paper);
  font-family: var(--mono);
  font-size: 1rem;
  line-height: 1;
  cursor: pointer;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background var(--t-fast), color var(--t-fast);
}
.popover-close:hover {
  background: var(--ink);
  color: var(--paper);
}

.popover-card .image-wrap {
  position: relative;
  aspect-ratio: 16 / 9;
  overflow: hidden;
  background: var(--ivory);
  border-bottom: 1px solid var(--ink);
}
.popover-card .image-wrap img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
.popover-card .network-chip {
  position: absolute;
  top: 0.5rem;
  left: 0.5rem;
  padding: 0.2rem 0.5rem;
  font-family: var(--mono);
  font-size: 0.65rem;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  background: var(--paper);
  border: 1px solid var(--ink);
}
.popover-card .network-chip[data-accent="forest"] { color: var(--forest); }
.popover-card .network-chip[data-accent="rust"] { color: var(--rust); }

.popover-card .body {
  padding: 1rem;
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
}
.popover-card .body h3 {
  font-family: var(--serif);
  font-weight: 500;
  font-size: 1.15rem;
  margin: 0;
}
.popover-card .locality {
  font-family: var(--mono);
  font-size: 0.7rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--rule);
  margin: 0;
}
.popover-card .summary {
  font-family: var(--serif);
  font-size: 0.95rem;
  color: var(--ink);
  margin: 0;
  line-height: 1.5;
}
.popover-card .meta {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-top: 0.5rem;
  border-top: 1px dashed var(--rule);
  padding-top: 0.5rem;
  gap: 0.5rem;
}
.popover-card .theme-tag {
  font-family: var(--mono);
  font-size: 0.7rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--rule);
}
.popover-card .ext-link {
  font-family: var(--mono);
  font-size: 0.72rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--ink);
  text-decoration: none;
  border-bottom: 1px solid var(--ink);
}
.popover-card .ext-link:hover { color: var(--rust); border-bottom-color: var(--rust); }

@media (max-width: 720px) {
  .popover-stack {
    top: auto;
    bottom: 1rem;
    right: 1rem;
    left: 1rem;
    width: auto;
  }
  .popover-card { box-shadow: 4px 4px 0 var(--ink); }
  .map-hint { font-size: 0.65rem; }
}
</style>
