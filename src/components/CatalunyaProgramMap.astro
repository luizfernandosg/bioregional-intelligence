---
// src/components/CatalunyaProgramMap.astro
// Article-view interactive program map. Zoomable + navigable: pan/wheel/pinch,
// floating zoom controls, province quick-zoom chips, sub-zoom click-shortcut,
// click-marker-for-popover.
import type { Project, NetworkMeta } from "../content.config";
import { initialTileDataUrl } from "../lib/initial-tile";

interface Props {
  projects: Project[];
  networks: Record<"miceli" | "keras-buti", NetworkMeta>;
}
const { projects, networks } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
const geoUrl = `${baseUrl}/geo/catalunya-comarques.geojson`;
const payload = projects.map((p) => ({
  id: p.id,
  lat: p.geo.lat,
  lng: p.geo.lng,
  name: p.name,
  network: p.network,
  locality: p.locality,
}));
const cardImage = (p: Project): string => {
  if (p.image) return `${baseUrl}${p.image}`;
  const meta = networks[p.network];
  return initialTileDataUrl({ initial: p.name.charAt(0), accent: meta.accent });
};
---

<div class="program-map" data-program-map data-geo-url={geoUrl}>
  <div class="map-controls" aria-label="Map navigation">
    <div class="province-strip" role="tablist">
      <button class="prov-chip active" data-prov="catalunya" type="button">Catalunya</button>
      <button class="prov-chip" data-prov="barcelona" type="button">Barcelona</button>
      <button class="prov-chip" data-prov="tarragona" type="button">Tarragona</button>
      <button class="prov-chip" data-prov="lleida" type="button">Lleida</button>
      <button class="prov-chip" data-prov="girona" type="button">Girona</button>
    </div>
    <p class="map-hint">Click a marker · Scroll to zoom · Drag to pan</p>
  </div>

  <svg viewBox="0 0 1400 900" preserveAspectRatio="xMidYMid meet" aria-label="Regenerant Catalunya — interactive program map" tabindex="0">
    <g class="zoom-root">
      <g class="comarques"></g>
      <g class="markers"></g>
    </g>
    <!-- Sub-zoom callout sits OUTSIDE the zoom-root so it stays fixed in the corner. -->
    <g class="subzoom" transform="translate(1140 720)" data-subzoom-shortcut role="button" tabindex="0" aria-label="Zoom into L'Hospitalet metro">
      <rect class="subzoom-frame" x="0" y="0" width="240" height="160"/>
      <text class="subzoom-label" x="8" y="16">L'Hospitalet · Baix Llobregat</text>
      <text class="subzoom-cta" x="232" y="16" text-anchor="end">↗</text>
      <g class="subzoom-comarques"></g>
      <g class="subzoom-markers"></g>
    </g>
  </svg>

  <div class="zoom-buttons" aria-label="Zoom controls">
    <button class="zoom-btn" data-zoom-in type="button" aria-label="Zoom in">+</button>
    <button class="zoom-btn" data-zoom-out type="button" aria-label="Zoom out">−</button>
    <button class="zoom-btn" data-zoom-reset type="button" aria-label="Fit Catalunya">↺</button>
  </div>

  <!-- Pre-rendered popover cards (hidden by default; revealed on marker click). -->
  <div class="popover-stack" aria-live="polite">
    {projects.map((p) => {
      const meta = networks[p.network];
      const themeLabel = p.theme.replace(/-/g, " ");
      return (
        <article class="popover-card" data-popover-id={p.id} data-network={p.network} hidden>
          <button class="popover-close" type="button" aria-label="Close project">×</button>
          <div class="image-wrap">
            <img src={cardImage(p)} alt={`${p.name} — ${p.theme}`} loading="lazy" />
            <span class="network-chip" data-accent={meta.accent}>{meta.name.split(" / ")[0]}</span>
          </div>
          <div class="body">
            <h3>{p.name}</h3>
            <p class="locality">{p.locality}</p>
            <p class="summary">{p.summary}</p>
            <div class="meta">
              <span class="theme-tag">{themeLabel}</span>
              {p.links.web && (
                <a class="ext-link" href={p.links.web} target="_blank" rel="noopener noreferrer">↗ visit</a>
              )}
            </div>
          </div>
        </article>
      );
    })}
  </div>

  <script type="application/json" data-payload set:html={JSON.stringify(payload)}></script>
</div>

<script>
import * as d3 from "d3";
import {
  CATALUNYA_DEFAULT,
  LHOSPITALET_SUBZOOM,
  makeProjection,
  placeMarkers,
} from "../lib/catalunya-projection";

interface Marker {
  id: string;
  lat: number;
  lng: number;
  name: string;
  network: "miceli" | "keras-buti";
  locality: string;
}

const ACCENT_FILL: Record<string, string> = {
  miceli: "#8B5A3C",
  "keras-buti": "#6B4EA3",
};

// Province bounding boxes (lng/lat) — used for click-to-zoom navigation.
type BBox = [number, number, number, number];
const PROVINCE_BBOX: Record<string, BBox> = {
  catalunya: [0.15, 40.52, 3.32, 42.86],
  barcelona: [1.45, 41.16, 2.85, 42.05],
  tarragona: [0.10, 40.52, 1.65, 41.45],
  lleida:    [0.55, 41.30, 1.85, 42.86],
  girona:    [1.85, 41.60, 3.32, 42.55],
};
// L'Hospitalet metro click-shortcut bbox (smaller, tight on the metro area).
const LHOSPITALET_BBOX: BBox = [1.95, 41.30, 2.25, 41.42];

const VIEW_W = 1400;
const VIEW_H = 900;
const SCALE_MIN = 1;
const SCALE_MAX = 8;

const prefersReducedMotion = () =>
  window.matchMedia("(prefers-reduced-motion: reduce)").matches;

document.querySelectorAll<HTMLDivElement>("[data-program-map]").forEach(async (host) => {
  const payloadEl = host.querySelector<HTMLScriptElement>('[data-payload]');
  if (!payloadEl) return;
  const markers: Marker[] = JSON.parse(payloadEl.textContent ?? "[]");

  const geoUrl = host.dataset.geoUrl ?? "/geo/catalunya-comarques.geojson";
  const geoResp = await fetch(geoUrl);
  const geo = await geoResp.json();

  const svgEl = host.querySelector<SVGSVGElement>("svg");
  if (!svgEl) return;
  const svg = d3.select(svgEl);
  const zoomRoot = svg.select<SVGGElement>("g.zoom-root");

  const projection = makeProjection(CATALUNYA_DEFAULT);
  const path = d3.geoPath(projection);

  // Comarques (inside zoom-root → pan/zoom transforms apply)
  zoomRoot.select<SVGGElement>("g.comarques")
    .selectAll("path")
    .data(geo.features as any[])
    .join("path")
    .attr("d", (d) => path(d as any) ?? "")
    .attr("class", "comarca");

  // Main-map markers — exclude L'Hospitalet metro markers, those live in the sub-zoom.
  const isLHospitalet = (m: Marker) =>
    m.locality.toLowerCase().includes("l'hospitalet");
  const placedMain = placeMarkers(
    markers.filter((m) => !isLHospitalet(m)),
    projection,
  );
  const lhospitaletMarkers = markers.filter(isLHospitalet);
  drawMarkers(zoomRoot.select<SVGGElement>("g.markers"), placedMain, 11);

  // Sub-zoom (outside zoom-root; stays fixed)
  const subProjection = makeProjection(LHOSPITALET_SUBZOOM);
  const subPath = d3.geoPath(subProjection);
  const subFeatures = (geo.features as any[]).filter((f) => {
    const name = (f.properties?.NOMCOMAR || f.properties?.name || "").toLowerCase();
    return name.includes("barcelonès") || name.includes("baix llobregat");
  });
  svg.select<SVGGElement>("g.subzoom-comarques")
    .selectAll("path")
    .data(subFeatures)
    .join("path")
    .attr("d", (d) => subPath(d as any) ?? "")
    .attr("class", "subzoom-comarca");
  const placedSub = placeMarkers(lhospitaletMarkers, subProjection);
  drawMarkers(svg.select<SVGGElement>("g.subzoom-markers"), placedSub, 6);

  function drawMarkers(g: d3.Selection<SVGGElement, unknown, null, undefined>, items: any[], radius: number) {
    g.selectAll("g.marker")
      .data(items, (d: any) => d.id)
      .join((enter) => {
        const node = enter.append("g")
          .attr("class", "marker")
          .attr("data-project-id", (d: any) => d.id)
          .attr("data-network", (d: any) => d.network)
          .attr("transform", (d: any) => `translate(${d.x},${d.y})`)
          .attr("tabindex", 0)
          .attr("role", "button")
          .attr("aria-label", (d: any) => `${d.name} — ${d.locality}`);
        node.append("circle")
          .attr("class", "marker-dot")
          .attr("r", radius)
          .attr("fill", (d: any) => ACCENT_FILL[d.network] ?? "#1d1a16")
          .attr("stroke", "#1d1a16")
          .attr("stroke-width", 2);
        node.append("title").text((d: any) => `${d.name} · ${d.locality}`);
        return node;
      });
  }

  // ===== ZOOM SETUP =====
  const zoom = d3.zoom<SVGSVGElement, unknown>()
    .scaleExtent([SCALE_MIN, SCALE_MAX])
    .filter((event) => {
      // Allow wheel zoom + drag pan + touch. Block when interacting with markers
      // (so a click on a marker fires the popover, not a pan-start).
      const target = event.target as Element;
      if (target.closest("g.marker")) return false;
      if (target.closest("g.subzoom")) return false;
      if (event.type === "dblclick") return false;
      return !event.button;
    })
    .on("zoom", (event) => {
      const t = event.transform;
      zoomRoot.attr("transform", `${t}`);
      // Counter-scale markers so they stay visually consistent
      const inv = 1 / t.k;
      zoomRoot.selectAll<SVGGElement, any>("g.marker").each(function (this: SVGGElement, d: any) {
        const x = d?.x ?? 0;
        const y = d?.y ?? 0;
        d3.select(this).attr("transform", `translate(${x},${y}) scale(${inv})`);
      });
      zoomRoot.selectAll<SVGCircleElement, unknown>(".marker-dot")
        .attr("stroke-width", 2 * inv);
      zoomRoot.selectAll<SVGPathElement, unknown>(".comarca")
        .attr("stroke-width", 0.5 * inv);
    });

  svg.call(zoom);
  // Disable d3-zoom's double-click-to-zoom (we use buttons instead).
  svg.on("dblclick.zoom", null);

  function animateToBBox(bbox: BBox, padding = 80) {
    const [w, s, e, n] = bbox;
    const tl = projection([w, n]);
    const br = projection([e, s]);
    if (!tl || !br) return;
    const dx = Math.abs(br[0] - tl[0]);
    const dy = Math.abs(br[1] - tl[1]);
    if (dx === 0 || dy === 0) return;
    const k = Math.min(
      SCALE_MAX,
      Math.max(SCALE_MIN, Math.min((VIEW_W - 2 * padding) / dx, (VIEW_H - 2 * padding) / dy)),
    );
    const cx = (tl[0] + br[0]) / 2;
    const cy = (tl[1] + br[1]) / 2;
    const transform = d3.zoomIdentity
      .translate(VIEW_W / 2 - k * cx, VIEW_H / 2 - k * cy)
      .scale(k);
    svg.transition()
      .duration(prefersReducedMotion() ? 0 : 600)
      .ease(d3.easeCubicInOut)
      .call(zoom.transform as any, transform);
  }

  function zoomBy(factor: number) {
    svg.transition()
      .duration(prefersReducedMotion() ? 0 : 220)
      .ease(d3.easeCubicOut)
      .call(zoom.scaleBy as any, factor);
  }

  // Zoom button handlers
  host.querySelector<HTMLButtonElement>("[data-zoom-in]")?.addEventListener("click", () => zoomBy(1.6));
  host.querySelector<HTMLButtonElement>("[data-zoom-out]")?.addEventListener("click", () => zoomBy(1 / 1.6));
  host.querySelector<HTMLButtonElement>("[data-zoom-reset]")?.addEventListener("click", () => animateToBBox(PROVINCE_BBOX.catalunya));

  // Province chip handlers
  const chips = host.querySelectorAll<HTMLButtonElement>(".prov-chip");
  chips.forEach((chip) => {
    chip.addEventListener("click", () => {
      const prov = chip.dataset.prov;
      if (!prov || !PROVINCE_BBOX[prov]) return;
      chips.forEach((c) => c.classList.toggle("active", c === chip));
      animateToBBox(PROVINCE_BBOX[prov]);
    });
  });

  // L'Hospitalet sub-zoom shortcut
  const subzoomEl = svg.select("g[data-subzoom-shortcut]");
  const subzoomActivate = () => {
    chips.forEach((c) => c.classList.toggle("active", c.dataset.prov === "barcelona"));
    animateToBBox(LHOSPITALET_BBOX, 40);
  };
  subzoomEl.on("click", subzoomActivate);
  subzoomEl.on("keydown", (event: KeyboardEvent) => {
    if (event.key === "Enter" || event.key === " ") {
      event.preventDefault();
      subzoomActivate();
    }
  });

  // ===== POPOVER BEHAVIOR =====
  const popovers = host.querySelectorAll<HTMLElement>("[data-popover-id]");
  const allMarkerNodes = svg.selectAll<SVGGElement, unknown>("g.marker");
  const hint = host.querySelector<HTMLElement>(".map-hint");

  const closePopovers = () => {
    popovers.forEach((p) => (p.hidden = true));
    allMarkerNodes.classed("active", false);
    if (hint) hint.style.opacity = "1";
  };

  const openPopover = (id: string) => {
    closePopovers();
    const target = host.querySelector<HTMLElement>(`[data-popover-id="${id}"]`);
    if (!target) return;
    target.hidden = false;
    svg.selectAll<SVGGElement, unknown>(`g.marker[data-project-id="${id}"]`).classed("active", true);
    if (hint) hint.style.opacity = "0";
  };

  allMarkerNodes.each(function (this: SVGGElement) {
    const id = this.getAttribute("data-project-id");
    if (!id) return;
    const sel = d3.select(this);
    sel.on("click", (event) => {
      event.stopPropagation();
      openPopover(id);
    });
    sel.on("keydown", (event: KeyboardEvent) => {
      if (event.key === "Enter" || event.key === " ") {
        event.preventDefault();
        openPopover(id);
      }
    });
  });

  popovers.forEach((p) => {
    const closeBtn = p.querySelector<HTMLButtonElement>(".popover-close");
    closeBtn?.addEventListener("click", () => closePopovers());
  });
  host.addEventListener("click", (event) => {
    const target = event.target as HTMLElement;
    if (target.closest("[data-popover-id]")) return;
    if (target.closest("g.marker")) return;
    if (target.closest(".prov-chip")) return;
    if (target.closest(".zoom-btn")) return;
    if (target.closest("g[data-subzoom-shortcut]")) return;
    closePopovers();
  });
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") closePopovers();
  });
});
</script>

<style>
.program-map {
  position: relative;
  width: 100%;
  height: clamp(520px, 78vh, 880px);
  background: var(--ivory);
  border: 2px solid var(--ink);
  overflow: hidden;
}
.program-map svg {
  width: 100%;
  height: 100%;
  display: block;
  touch-action: none; /* let D3 zoom handle pinch */
}
.program-map svg:focus-visible { outline: 2px solid var(--ink); outline-offset: -4px; }

.map-controls {
  position: absolute;
  top: 1rem;
  left: 1rem;
  right: 1rem;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 1rem;
  pointer-events: none;
  z-index: 2;
}
.province-strip {
  display: flex;
  flex-wrap: wrap;
  gap: 0;
  pointer-events: auto;
  background: var(--paper);
  border: 1px solid var(--ink);
}
.prov-chip {
  font-family: var(--mono);
  font-size: 0.7rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--ink);
  background: var(--paper);
  border: 0;
  border-right: 1px solid var(--ink);
  padding: 0.45rem 0.75rem;
  cursor: pointer;
  transition: background var(--t-fast), color var(--t-fast);
}
.prov-chip:last-child { border-right: 0; }
.prov-chip:hover { background: var(--ivory); }
.prov-chip.active {
  background: var(--ink);
  color: var(--paper);
}

.map-hint {
  margin: 0;
  padding: 0.45rem 0.75rem;
  font-family: var(--mono);
  font-size: 0.7rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--rule);
  background: var(--paper);
  border: 1px solid var(--rule);
  pointer-events: none;
  white-space: nowrap;
  transition: opacity var(--t-fast);
}

.zoom-buttons {
  position: absolute;
  bottom: 1rem;
  right: 1rem;
  display: flex;
  flex-direction: column;
  gap: 0;
  background: var(--paper);
  border: 1px solid var(--ink);
  z-index: 2;
}
.zoom-btn {
  width: 2.4rem;
  height: 2.4rem;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--mono);
  font-size: 1.05rem;
  line-height: 1;
  background: var(--paper);
  color: var(--ink);
  border: 0;
  border-bottom: 1px solid var(--ink);
  cursor: pointer;
  transition: background var(--t-fast), color var(--t-fast);
}
.zoom-btn:last-child { border-bottom: 0; }
.zoom-btn:hover, .zoom-btn:focus-visible {
  background: var(--ink);
  color: var(--paper);
  outline: none;
}

:global(.program-map .comarca) {
  fill: rgba(0, 0, 0, 0.03);
  stroke: var(--ink);
  stroke-width: 0.5;
  stroke-dasharray: 1 2;
  transition: fill var(--t-fast);
}
:global(.program-map .comarca:hover) {
  fill: rgba(0, 0, 0, 0.08);
}
:global(.program-map .subzoom-comarca) {
  fill: rgba(0, 0, 0, 0.03);
  stroke: var(--ink);
  stroke-width: 0.5;
  stroke-dasharray: 1 2;
}
:global(.program-map .marker) {
  cursor: pointer;
  transition: opacity var(--t-fast);
  transform-box: fill-box;
}
:global(.program-map .marker .marker-dot) {
  transition: r var(--t-med), stroke-width var(--t-fast);
}
:global(.program-map .marker:hover .marker-dot),
:global(.program-map .marker:focus-visible .marker-dot) {
  stroke-width: 3;
}
:global(.program-map .marker.active .marker-dot) {
  stroke-width: 3;
  filter: drop-shadow(0 1px 0 rgba(0,0,0,0.18));
}
:global(.program-map .marker:focus-visible) { outline: none; }

:global(.program-map .subzoom) { cursor: pointer; transition: filter var(--t-fast); }
:global(.program-map .subzoom:hover .subzoom-frame) { fill: var(--ivory); }
:global(.program-map .subzoom:focus-visible .subzoom-frame) { stroke-width: 2; outline: none; }
:global(.program-map .subzoom-frame) {
  fill: var(--paper);
  stroke: var(--ink);
  stroke-width: 1;
}
:global(.program-map .subzoom-label) {
  font-family: var(--mono);
  font-size: 9px;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  fill: var(--rule);
}
:global(.program-map .subzoom-cta) {
  font-family: var(--mono);
  font-size: 11px;
  fill: var(--ink);
}

.popover-stack {
  position: absolute;
  top: 4.5rem;
  right: 1rem;
  width: min(360px, calc(100% - 2rem));
  pointer-events: none;
  z-index: 3;
}
.popover-card {
  pointer-events: auto;
  background: var(--paper);
  border: 1px solid var(--ink);
  box-shadow: 6px 6px 0 var(--ink);
  display: flex;
  flex-direction: column;
  position: relative;
  animation: popover-in 220ms ease;
}
@keyframes popover-in {
  from { opacity: 0; transform: translateY(-4px) scale(0.98); }
  to   { opacity: 1; transform: translateY(0) scale(1); }
}
.popover-card[hidden] { display: none; }

.popover-close {
  position: absolute;
  top: 0.4rem;
  right: 0.4rem;
  width: 1.7rem;
  height: 1.7rem;
  border: 1px solid var(--ink);
  background: var(--paper);
  font-family: var(--mono);
  font-size: 1rem;
  line-height: 1;
  cursor: pointer;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background var(--t-fast), color var(--t-fast);
}
.popover-close:hover {
  background: var(--ink);
  color: var(--paper);
}

.popover-card .image-wrap {
  position: relative;
  aspect-ratio: 16 / 9;
  overflow: hidden;
  background: var(--ivory);
  border-bottom: 1px solid var(--ink);
}
.popover-card .image-wrap img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
.popover-card .network-chip {
  position: absolute;
  top: 0.5rem;
  left: 0.5rem;
  padding: 0.2rem 0.5rem;
  font-family: var(--mono);
  font-size: 0.65rem;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  background: var(--paper);
  border: 1px solid var(--ink);
}
.popover-card .network-chip[data-accent="forest"] { color: var(--forest); }
.popover-card .network-chip[data-accent="rust"] { color: var(--rust); }

.popover-card .body {
  padding: 1rem;
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
}
.popover-card .body h3 {
  font-family: var(--serif);
  font-weight: 500;
  font-size: 1.15rem;
  margin: 0;
}
.popover-card .locality {
  font-family: var(--mono);
  font-size: 0.7rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--rule);
  margin: 0;
}
.popover-card .summary {
  font-family: var(--serif);
  font-size: 0.95rem;
  color: var(--ink);
  margin: 0;
  line-height: 1.5;
}
.popover-card .meta {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-top: 0.5rem;
  border-top: 1px dashed var(--rule);
  padding-top: 0.5rem;
  gap: 0.5rem;
}
.popover-card .theme-tag {
  font-family: var(--mono);
  font-size: 0.7rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--rule);
}
.popover-card .ext-link {
  font-family: var(--mono);
  font-size: 0.72rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--ink);
  text-decoration: none;
  border-bottom: 1px solid var(--ink);
}
.popover-card .ext-link:hover { color: var(--rust); border-bottom-color: var(--rust); }

@media (max-width: 880px) {
  .map-controls { flex-direction: column; align-items: flex-start; }
  .map-hint { display: none; }
}
@media (max-width: 720px) {
  .popover-stack {
    top: auto;
    bottom: 1rem;
    right: 1rem;
    left: 1rem;
    width: auto;
  }
  .popover-card { box-shadow: 4px 4px 0 var(--ink); }
}
</style>
