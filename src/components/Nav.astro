---
// src/components/Nav.astro
interface Props {
  current?: "home" | "programs" | "actors" | "indicators" | "about";
  // Right-most segment of the brand line — names the dataset/view in scope.
  // Defaults to "Catalunya" (general bioregion); program pages pass "Regenerant Catalunya".
  dataset?: string;
}
const { current = "home", dataset = "Catalunya" } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const items = [
  { id: "programs", label: "Programs", href: `${base}/programs/regenerant-catalunya/` },
  { id: "actors", label: "Actors", href: `${base}/actors/` },
  { id: "indicators", label: "Indicators", href: `${base}/indicators/` },
  { id: "about", label: "About", href: `${base}/about/` },
] as const;
---

<header class="site-nav">
  <a href={`${base}/`} class="brand" aria-label="ReFi BCN — Bioregional Intelligence System — home">
    <span class="brand-org">ReFi BCN</span>
    <span class="brand-sep">•</span>
    <span class="brand-system">Bioregional Intelligence System</span>
    <span class="brand-sep">•</span>
    <span class="brand-dataset">{dataset}</span>
  </a>
  <nav aria-label="Primary">
    <ul>
      {items.map((it) => (
        <li>
          <a href={it.href} class:list={[{ active: current === it.id }]}>
            {it.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
.site-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 1rem 2rem;
  border-bottom: 1px solid var(--ink);
  background: var(--paper);
  position: sticky;
  top: 0;
  z-index: 10;
}
.brand {
  display: flex;
  align-items: baseline;
  gap: 0.6rem;
  text-decoration: none;
  color: var(--ink);
  font-family: var(--mono);
  font-size: 0.78rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
}
.brand-org {
  font-weight: 500;
  color: var(--ink);
}
.brand-system {
  color: var(--rule);
}
.brand-dataset {
  color: var(--ink);
  font-weight: 500;
}
.brand-sep {
  color: var(--rule);
  opacity: 0.6;
}
@media (max-width: 880px) {
  .brand-system { display: none; }
  .brand-sep:nth-of-type(1) { display: none; }
}
@media (max-width: 560px) {
  .brand-sep { display: none; }
  .brand { gap: 0.4rem; }
  .brand-org { display: none; }
}
nav ul {
  list-style: none;
  display: flex;
  gap: 1.5rem;
  margin: 0;
  padding: 0;
}
nav a {
  font-family: var(--mono);
  font-size: 0.78rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--rule);
  text-decoration: none;
  padding: 0.25rem 0;
  border-bottom: 1px solid transparent;
}
nav a.active,
nav a:hover {
  color: var(--ink);
  border-bottom-color: var(--ink);
}
@media (max-width: 640px) {
  .brand-text { display: none; }
  nav ul { gap: 1rem; }
  nav a { font-size: 0.7rem; }
}
</style>
